---
/**
 * 轻量灯箱（原生 TS）：监听 [data-lightbox] 触发的图片放大查看。
 * 键盘可操作：Esc 关闭，←/→ 切换。
 */
---

<dialog class="lightbox" id="lightbox" aria-label="图片放大查看">
  <button class="lightbox-close" type="button" aria-label="关闭">×</button>
  <button class="lightbox-prev" type="button" aria-label="上一张">‹</button>
  <figure>
    <img src="/favicon.svg" alt="" />
    <figcaption aria-live="polite" aria-atomic="true"></figcaption>
  </figure>
  <button class="lightbox-next" type="button" aria-label="下一张">›</button>
</dialog>

<style>
  .lightbox {
    border: none;
    padding: 0;
    background: transparent;
    width: min(92vw, 1200px);
    max-width: 92vw;
    max-height: 92dvh;
  }

  .lightbox::backdrop {
    background: rgba(26, 26, 23, 0.88);
  }

  .lightbox figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .lightbox img {
    width: 100%;
    height: min(76dvh, 900px);
    object-fit: contain;
    border-radius: var(--radius);
  }

  .lightbox figcaption {
    color: var(--bg);
    font-size: var(--fs-small);
    text-align: center;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
  }

  .lightbox button {
    position: absolute;
    background: rgba(26, 26, 23, 0.8);
    color: var(--bg);
    border: 1px solid rgba(245, 244, 237, 0.4);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 1.4rem;
    cursor: pointer;
    display: grid;
    place-items: center;
    z-index: 1;
  }

  .lightbox button:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  .lightbox-close {
    top: 0.6rem;
    right: 0.6rem;
  }

  .lightbox-prev {
    left: 0.6rem;
    top: 45%;
  }

  .lightbox-next {
    right: 0.6rem;
    top: 45%;
  }

  @media (max-width: 640px) {
    .lightbox-close {
      top: 0.4rem;
      right: 0.4rem;
    }
    .lightbox-prev {
      left: 0.4rem;
    }
    .lightbox-next {
      right: 0.4rem;
    }
  }
</style>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dlg) {
    const imgEl = dlg.querySelector('img')!;
    const capEl = dlg.querySelector('figcaption')!;
    const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox]'));
    let items: HTMLElement[] = [];
    let current = 0;
    let lastFocus: HTMLElement | null = null;
    let previousOverflow = '';

    function show(i: number) {
      if (!items.length) return;
      current = (i + items.length) % items.length;
      const item = items[current];
      imgEl.src = item.dataset.lightboxSrc!;
      imgEl.alt = item.dataset.lightboxAlt ?? '';
      capEl.textContent = `${current + 1} / ${items.length} ｜ ${item.dataset.lightboxCaption ?? ''}`;
    }

    triggers.forEach((t) => {
      t.addEventListener('click', () => {
        items = triggers.filter((trigger) => trigger.getClientRects().length > 0 && trigger.dataset.lightboxSrc);
        const index = items.indexOf(t);
        if (index < 0 || dlg.open) return;
        lastFocus = t;
        show(index);
        previousOverflow = document.documentElement.style.overflow;
        document.documentElement.style.overflow = 'hidden';
        dlg!.showModal();
      });
    });

    dlg.querySelector('.lightbox-close')?.addEventListener('click', () => dlg!.close());
    dlg.querySelector('.lightbox-prev')?.addEventListener('click', () => show(current - 1));
    dlg.querySelector('.lightbox-next')?.addEventListener('click', () => show(current + 1));

    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg!.close();
    });

    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') e.preventDefault();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    dlg.addEventListener('close', () => {
      document.documentElement.style.overflow = previousOverflow;
      imgEl.src = '/favicon.svg';
      imgEl.alt = '';
      capEl.textContent = '';
      lastFocus?.focus({ preventScroll: true });
    });
  }
</script>
